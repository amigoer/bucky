<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="bucky-desktop"
        Arguments=""
        InstallLocation="C:\Program Files\Amigoer\Bucky">
    </Installer>
    <PackageInformation
        PackageName="Bucky"
        PackageDisplayName="Bucky"
        PublisherName="CN=Amigoer"
        PublisherDisplayName="Amigoer"
        Version="0.1.0.0"
        PackageDescription="Cloudflare R2 object storage client">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.amigoer.bucky"
                Description="Cloudflare R2 object storage client"
                DisplayName="Bucky"
                ExecutableName="bucky-desktop"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Bucky</DisplayName>
            <PublisherDisplayName>Amigoer</PublisherDisplayName>
            <Description>Cloudflare R2 object storage client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="bucky.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
